# MongoDB Atlas Connection String
# Replace <username>, <password>, <cluster-url>, and <database_name> with your client's Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database_name>?retryWrites=true&w=majority

# Direct seed list format (use if network blocks DNS SRV queries):
# MONGODB_URI=mongodb://<username>:<password>@cluster0-shard-00-00.mongodb.net:27017,cluster0-shard-00-01.mongodb.net:27017,cluster0-shard-00-02.mongodb.net:27017/<database_name>?authSource=admin&replicaSet=atlas-shard-0&ssl=true&retryWrites=true&w=majority

# Application Port
PORT=5000

# Secret Key for JWT Tokens
JWT_SECRET=your_secure_jwt_secret_key_here
